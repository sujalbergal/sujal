---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex-1">
          <h2 class="mb-3 text-xl font-semibold text-slate-100">Filter games</h2>
          <p class="text-sm text-slate-300" data-testid="filter-results-count">{games.length} game{games.length === 1 ? '' : 's'} found</p>
        </div>

        <button
          type="button"
          class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:border-blue-500 hover:text-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>

      <form class="mt-5 space-y-5" data-testid="game-filters">
        <fieldset class="space-y-3" data-testid="category-filter-group">
          <legend class="text-sm font-medium text-slate-200">Category</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-200 hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`category-filter-option-${category.id}`}
              >
                <input
                  type="checkbox"
                  value={category.id}
                  name="category"
                  class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 accent-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="max-w-md">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>
      </form>
    </div>

    <div>
      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div hidden data-testid="games-empty-state" class="rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-slate-200">
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    (() => {
      const categoryInputs = Array.from(document.querySelectorAll('input[name="category"]'));
      const publisherSelect = document.querySelector('[data-testid="publisher-filter"]');
      const clearButton = document.querySelector('[data-testid="clear-filters"]');
      const emptyState = document.querySelector('[data-testid="games-empty-state"]');
      const resultsCount = document.querySelector('[data-testid="filter-results-count"]');
      const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));

      function applyFilters() {
        const selectedCategories = categoryInputs
          .filter((input) => input.checked)
          .map((input) => Number(input.value));
        const selectedPublisher = publisherSelect && publisherSelect.value ? Number(publisherSelect.value) : null;

        let visibleCount = 0;

        cards.forEach((card) => {
          const categoryId = card.dataset.gameCategory ? Number(card.dataset.gameCategory) : null;
          const publisherId = card.dataset.gamePublisher ? Number(card.dataset.gamePublisher) : null;
          const matchesCategory = selectedCategories.length === 0 || (categoryId !== null && selectedCategories.includes(categoryId));
          const matchesPublisher = selectedPublisher === null || publisherId === selectedPublisher;
          const isVisible = matchesCategory && matchesPublisher;

          card.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (resultsCount) {
          resultsCount.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} found`;
        }

        if (emptyState) {
          emptyState.hidden = visibleCount !== 0;
        }
      }

      categoryInputs.forEach((input) => {
        input.addEventListener('change', applyFilters);
      });

      if (publisherSelect) {
        publisherSelect.addEventListener('change', applyFilters);
      }

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          categoryInputs.forEach((input) => {
            input.checked = false;
          });

          if (publisherSelect) {
            publisherSelect.value = '';
          }

          applyFilters();
        });
      }

      applyFilters();
    })();
  </script>
</Layout>
